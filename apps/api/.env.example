PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=dev-only-change-me
DATABASE_URL=postgresql://bayadrent:bayadrent@127.0.0.1:5433/bayadrent
REDIS_URL=redis://localhost:6379
# Optional object storage (Cloudflare R2 / MinIO / S3). When unset, files stay on local disk.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=bayadrent
S3_SECRET_KEY=bayadrent_secret
S3_BUCKET=bayadrent-proofs
S3_REGION=auto
# S3_PUBLIC_URL=

# Optional SMTP — when set, due reminders + payment emails are delivered.
# When unset, the same messages log to the API console (safe for local dev).
# Example (Mailtrap / Gmail app password / SES SMTP):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=secret
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BayadRent <noreply@bayadrent.local>

# JWT_SECRET must be a long random string in production.
# Upload dirs (uploads/proofs, uploads/gcash-qr) are created on API boot.
