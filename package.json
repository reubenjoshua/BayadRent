{
  "name": "bayadrent",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter api db:push"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  }
}
